MOCK_ML_URL=http://127.0.0.1:8001
MOCK_TOIR_URL=http://127.0.0.1:8002
# Set on the server only. The application uses gpt-6-luna.
OPENAI_API_KEY=
MANUALS_DIR=документы
MANUAL_PAGES=1
CORPUS_PATH=corpus/manuals.sqlite
# Optional directory containing rus.traineddata and eng.traineddata
TESSDATA_PREFIX=
# Optional. Install the separate voicekit package before setting this local model directory.
VOICE_MODEL_DIR=
# Vehicle conversation history is enabled on loopback by default.
CONVERSATIONS_DB=corpus/vehicle_conversations.sqlite
# Optional: hashed teammate accounts for HTTPS network access; store outside Git.
MECHANIC_USERS_FILE=
# Optional: read-only local JSON export from the repair journal; store outside Git.
REPAIR_LOG_FILE=
